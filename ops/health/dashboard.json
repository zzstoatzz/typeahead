    {
      "id": 10,
      "title": "Fly 5xx responses",
      "description": "5xx per rolling five minutes. Zero is filled only when other HTTP counter observations exist for that app; total telemetry loss remains NO DATA.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "typeahead-fly"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (increase(fly_app_http_responses_count{app=~\"typeahead-search|typeahead-ingester\",status=\"5xx\"}[5m])) or on(app) (0 * sum by(app) (increase(fly_app_http_responses_count{app=~\"typeahead-search|typeahead-ingester\"}[5m])))",
          "legendFormat": "{{app}}",
          "range": true,
