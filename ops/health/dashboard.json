    {
      "id": 9,
      "title": "Requests reaching Fly",
      "description": "Cloudflare cache hits do not reach Fly. Includes probes and status requests.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "typeahead-fly"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate(fly_app_http_responses_count{app=~\"typeahead-search|typeahead-ingester\"}[5m]))",
          "legendFormat": "{{app}}",
          "range": true,
          "instant": false
