      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "typeahead-fly"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fly_instance_filesystem_blocks_avail{app=\"typeahead-search\",mount=\"/data\"} * fly_instance_filesystem_block_size{app=\"typeahead-search\",mount=\"/data\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
