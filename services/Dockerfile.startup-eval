FROM registry.fly.io/typeahead-startup-20261024@sha256:5f7bbf06530fead019fd6464c0dbcdb5e5ff004d9a05128fab2bca427055de8f AS baseline

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils \
    unzip \
    && rm -rf /var/lib/apt/lists/* \
    # prefer IPv4 — tangled.org has flaky IPv6 that truncates tarball fetches
    && echo 'precedence ::ffff:0:0/96  100' >> /etc/gai.conf

# install zig 0.17.0 (stable)
RUN curl -L https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz | tar -xJ -C /usr/local \
    && ln -s /usr/local/zig-x86_64-linux-0.17.0/zig /usr/local/bin/zig

# rclone (pinned) for R2 transport — handles multipart upload (>5GiB) +
# streaming download + retries. Used by the indexer (upload) and search service
# (download); the ingester role doesn't use it (TODO: split images by role).
RUN curl -fsSL https://downloads.rclone.org/v1.69.1/rclone-v1.69.1-linux-amd64.zip -o /tmp/rclone.zip \
    && unzip -j /tmp/rclone.zip 'rclone-*/rclone' -d /usr/local/bin \
    && chmod +x /usr/local/bin/rclone \
    && rm /tmp/rclone.zip

WORKDIR /app
COPY services/build.zig services/build.zig.zon ./
COPY services/src ./src

# seed the zig package cache from the vendored dep tarballs so the build
# needs no dep fetches at all — tangled.org 503s zig's fetch client
# (observed 2026-08-14: depot builder and local docker both blocked while
# plain curl succeeded). Refresh with scripts/vendor-zig-deps.py after any
# dep bump in build.zig.zon.
COPY services/.zig-pkg-vendor /root/.cache/zig/p/

# -Dtarget pins the x86-64 baseline explicitly: native CPU detection breaks
# under emulated local builds (Rosetta reports an unknown CPU model)
RUN --network=none zig build test --summary all -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu
RUN --network=none zig build eval-server compact -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu -p /out/candidate

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 curl sqlite3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/candidate/bin/eval-server /app/candidate
COPY --from=baseline /app/baseline /app/baseline
COPY --from=builder /out/candidate/lib/libtypeahead_compact.so /app/libtypeahead_compact.so
COPY scripts/snapshot_compaction /app/snapshot_compaction
COPY scripts/startup_eval.py /app/startup_eval.py
COPY scripts/startup-eval-queries.json /app/queries.json
ENV TYPEAHEAD_COMPACT_LIBRARY=/app/libtypeahead_compact.so
RUN cd /app/snapshot_compaction && python3 -m unittest -v test_native
CMD ["sleep", "infinity"]
