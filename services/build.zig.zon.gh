// GitHub-mirror fallback manifest. Identical to build.zig.zon except the
// four tangled.org-hosted deps point at GitHub mirrors (same content → same
// hashes). The Dockerfile copies this over build.zig.zon and rebuilds ONLY if
// the primary (tangled.org) fetch fails — tangled's origin 502s
// intermittently and there is no per-dep fallback URL in zig's package system.
// Mirrors: zzstoatzz/{zug,poolio,logfire-zig,zat-mirror}. Keep hashes in sync
// with build.zig.zon; a mismatch fails the build loudly with the right value.
.{
    .name = .typeahead_ingester,
    .version = "0.0.1",
    .fingerprint = 0xc3959a06c9697d7c,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zat = .{
            .url = "https://github.com/zzstoatzz/zat-mirror/archive/refs/tags/v0.3.0-alpha.15.tar.gz",
            .hash = "zat-0.3.0-alpha.15-5PuC7nVhBQCJEzz9LuzSbtLb68Wd0x_yjDgTP3EqV8dH",
        },
        .zqlite = .{
            .url = "https://github.com/karlseguin/zqlite.zig/archive/a9c1cd3657315306856ddf4a8a28a11b10fd5a9d.tar.gz",
            .hash = "zqlite-0.0.1-RWLaYyc7nABTzVzEpEMPi3qD8xJHi0a2ycNgL73XyEdt",
        },
        .logfire = .{
            .url = "https://github.com/zzstoatzz/logfire-zig/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "logfire_zig-0.1.0-x2yDLr5wAADNrQCuIHDTBMgyrohjJkhSSXvJRuWU5SPv",
        },
        .zug = .{
            .url = "https://github.com/zzstoatzz/zug/archive/refs/tags/v0.1.2-alpha.0.tar.gz",
            .hash = "zug-0.1.2-alpha.0-h4vXbauvAAA2iBb7fFmNoqDr0SPX-98pP99OEkMHS1j9",
        },
        .poolio = .{
            .url = "https://github.com/zzstoatzz/poolio/archive/refs/tags/v0.0.1-alpha.1.tar.gz",
            .hash = "poolio-0.0.1-alpha.1-qYctK2JcAADiWqRISK92yk_GjGTVYeBEUGMrE4QtJE0N",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
