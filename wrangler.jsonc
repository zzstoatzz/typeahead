{
  "name": "typeahead",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } },
  "vars": {
    "SERVICE_DID": "did:plc:y6kywgnb7xletjpa5hhxmd4k",
    "PDS_UI_ENABLED": "1",
    "SEARCH_CACHE_GENERATION": "tantivy-b1793346536-cp-7c8322df79-cutover",
    "STATS_DUAL_WRITE": "1"
  },
  "services": [
    { "binding": "SEARCH_TRANSPORT", "service": "typeahead-search-transport" },
    { "binding": "IMAGE_RENDERER", "service": "typeahead-image-renderer" }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "af614e8f42a44543920f7aad0ae7b70a"
    }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "typeahead-stats",
      "database_id": "624dc8c4-2a82-42f5-920c-6489466f7b7e",
      "migrations_dir": "migrations/stats-d1"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "type": "ratelimit",
        "name": "RATE_LIMITER",
        "namespace_id": "0",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "type": "ratelimit",
        "name": "RATE_LIMITER_STRICT",
        "namespace_id": "0",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
}
