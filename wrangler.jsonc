{
  "name": "typeahead",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "SERVICE_DID": "did:plc:y6kywgnb7xletjpa5hhxmd4k",
    "PDS_UI_ENABLED": "0"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "af614e8f42a44543920f7aad0ae7b70a"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "type": "ratelimit",
        "name": "RATE_LIMITER",
        "namespace_id": "0",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "type": "ratelimit",
        "name": "RATE_LIMITER_STRICT",
        "namespace_id": "0",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
}
