FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
RUN apt-get update && apt-get install -y --no-install-recommends rclone ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chmod=0755 typeahead-tantivy /app/typeahead-tantivy
COPY tantivy-slot.py tantivy_install.py install.py /app/
COPY input /app/input
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python3", "/app/tantivy-slot.py"]
