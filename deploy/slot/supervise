#!/usr/bin/env bash
# Runs the store process and the index process side by side and keeps both
# running. A process that exits on its own is started again in place while
# the other is left alone: the index keeps answering searches through a store
# restart, and the store keeps following the relay through an index restart.
# The wait before a restart doubles from SLOT_RESTART_MIN_S up to
# SLOT_RESTART_MAX_S and returns to the minimum once the process has stayed
# up SLOT_RESTART_STABLE_S. SIGTERM and SIGINT stop the store first and the
# index after it, both with SIGTERM, because bash starts background commands
# with SIGINT ignored; the script then exits 0 when both stop cleanly. It
# exits on nothing else.
#
# The loop looks at its processes once a tick with `kill -0` and reads a dead
# one's status with `wait PID`. It does not use `wait -n`: bash 5.2, which the
# image has, drops a process from `wait -n` when it died by a signal while
# the shell was busy, or in the same instant as another.
set -uo pipefail

if ((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] < 502)); then
  echo "[supervisor] bash $BASH_VERSION is older than 5.2, the oldest this was run on" >&2
  exit 1
fi

data=${SLOT_DATA:-/data}
app=${SLOT_APP:-/app}
grace=${SLOT_STOP_GRACE_S:-50}
store_grace=${SLOT_STORE_STOP_S:-30}
restart_min=${SLOT_RESTART_MIN_S:-1}
restart_max=${SLOT_RESTART_MAX_S:-30}
restart_stable=${SLOT_RESTART_STABLE_S:-300}
tick=${SLOT_TICK_S:-1}
store_port=${STORE_PORT:-8082}

declare -A names=()       # pid of a running process -> store or index
declare -A restart_at=()  # store or index -> the second it is started again
# SECONDS counts whole seconds, so every deadline is passed with >, not >=:
# a wait is never shorter than it says and at most a second and a tick longer.
declare -A loggers=() started=() delay=() failures=() asked=()
stopping=""
kill_at=""
index_at=""
result=0

say() { printf '[supervisor] %s\n' "$*"; }

for forbidden in ADMIN_SECRET TYPEAHEAD_SECRET; do
  if [[ -n ${!forbidden:-} ]]; then
    say "$forbidden is set: a slot must not hold the Worker's admin secret"
    exit 1
  fi
done

# The store works in the background and search answers people: when both
# want a CPU, the index process gets it.
store_nice=${STORE_NICE:-10}

# options for the index process beyond its listeners and readiness
merge=()
[[ -n ${INDEX_MERGE_MIN_SEGMENTS:-} ]] && merge+=(--merge-min-segments "$INDEX_MERGE_MIN_SEGMENTS")
[[ -n ${INDEX_MERGE_LEVEL_LOG_SIZE:-} ]] && merge+=(--merge-level-log-size "$INDEX_MERGE_LEVEL_LOG_SIZE")
[[ -n ${INDEX_MERGE_MIN_LAYER_SIZE:-} ]] && merge+=(--merge-min-layer-size "$INDEX_MERGE_MIN_LAYER_SIZE")
[[ -n ${INDEX_MERGE_DELETE_RATIO:-} ]] && merge+=(--merge-delete-ratio "$INDEX_MERGE_DELETE_RATIO")
[[ -n ${INDEX_MERGE_MAX_DOCS:-} ]] && merge+=(--merge-max-docs "$INDEX_MERGE_MAX_DOCS")
[[ -n ${INDEX_MERGE_NICE:-} ]] && merge+=(--merge-nice "$INDEX_MERGE_NICE")
[[ -n ${INDEX_WARM_SEGMENT_FILES:-} ]] && merge+=(--warm-segment-files "$INDEX_WARM_SEGMENT_FILES")

# The image holds the store binary twice: built for any x86-64, and built
# for a CPU with AES, AVX and carry-less multiply as well. Zig picks its AES
# and GHASH when it compiles, and without those three it uses software
# versions, which was most of what reading the relay's TLS stream cost
# (docs/evals/collector-cpu-20261112). The second binary traps on a CPU
# that lacks an instruction it was built with, so it runs only where the
# kernel lists every one; anywhere else the first runs, as before.
store_bin=$app/typeahead-store
cpuinfo=${SLOT_CPUINFO:-/proc/cpuinfo}
aes_build_needs="cx16 lahf_lm popcnt pni ssse3 sse4_1 sse4_2 avx aes pclmulqdq"
if [[ -x $app/typeahead-store.aes ]]; then
  cpu_flags=" $(grep -m 1 '^flags' "$cpuinfo" 2>/dev/null | cut -d : -f 2) "
  cpu_lacks=""
  for flag in $aes_build_needs; do
    [[ $cpu_flags == *" $flag "* ]] || cpu_lacks+=" $flag"
  done
  if [[ -z $cpu_lacks ]]; then
    store_bin=$app/typeahead-store.aes
    say "store binary: the build that uses the CPU's AES"
  else
    say "store binary: the baseline build; this CPU does not report$cpu_lacks"
  fi
fi

run_store() {
  exec nice -n "$store_nice" env MODE=store STORE_DIR="$data/store" PORT="$store_port" "$store_bin"
}

run_index() {
  exec "$app/typeahead-tantivy" serve \
    --data "$data/tantivy" \
    --listen 0.0.0.0:8080 \
    --admin-listen 127.0.0.1:8081 \
    --max-sync-lag-s "${INDEX_MAX_SYNC_LAG_S:-120}" \
    --retrieval "${INDEX_RETRIEVAL:-global-merge}" \
    "${merge[@]}"
}

start() {
  local name=$1 out
  exec {out}> >(trap '' TERM INT; exec sed -u "s/^/[$name] /")
  loggers[$name]=$!
  "run_$name" >&"$out" 2>&1 &
  names[$!]=$name
  started[$name]=$SECONDS
  : "${delay[$name]:=$restart_min}" "${failures[$name]:=0}"
  exec {out}>&-
  say "started $name as pid $!"
}

restart_later() {
  local name=$1 up=$2 wait_s
  if ((up >= restart_stable)); then
    delay[$name]=$restart_min
    failures[$name]=0
  fi
  wait_s=${delay[$name]}
  delay[$name]=$((wait_s * 2 > restart_max ? restart_max : wait_s * 2))
  failures[$name]=$((failures[$name] + 1))
  restart_at[$name]=$((SECONDS + wait_s))
  say "$name stopped on its own, ${failures[$name]} time(s) without staying up ${restart_stable}s: starting it again in ${wait_s}s, ${names[*]:-nothing else} keeps running"
}

# Sends SIGTERM to the named process, once. Fails when it is not running.
stop() {
  local pid
  for pid in "${!names[@]}"; do
    [[ ${names[$pid]} == "$1" ]] || continue
    [[ -n ${asked[$1]:-} ]] && return 0
    asked[$1]=1
    say "sending SIGTERM to $1"
    kill -TERM "$pid" 2>/dev/null
    return 0
  done
  return 1
}

# The index is stopped once the store has, so it is never stopped under a
# push and answers searches for as long as it can. Nothing depends on the
# order: the bridge's cursor commits with the documents it covers.
stop_in_order() {
  if [[ -z $kill_at ]]; then
    say "received SIG$stopping"
    kill_at=$((SECONDS + grace))
    index_at=$((SECONDS + store_grace))
  fi
  if ! stop store || ((SECONDS > index_at)); then
    stop index
  fi
  if ((SECONDS > kill_at)); then
    say "${names[*]} still running ${grace}s after the stop was requested, sending SIGKILL"
    kill -KILL "${!names[@]}" 2>/dev/null
    kill_at=$((SECONDS + grace))
  fi
}

trap 'stopping=${stopping:-TERM}' TERM
trap 'stopping=${stopping:-INT}' INT

start store
start index

while :; do
  for pid in "${!names[@]}"; do
    kill -0 "$pid" 2>/dev/null && continue
    wait "$pid" 2>/dev/null
    code=$?
    name=${names[$pid]}
    unset "names[$pid]"
    up=$((SECONDS - started[$name]))
    say "$name exited with status $code after ${up}s"
    if [[ -z $stopping ]]; then
      restart_later "$name" "$up"
    elif ((result == 0)); then
      result=$code
    fi
  done
  if [[ -n $stopping ]]; then
    ((${#names[@]})) || break
    stop_in_order
  else
    for name in "${!restart_at[@]}"; do
      ((SECONDS > restart_at[$name])) || continue
      unset "restart_at[$name]"
      start "$name"
    done
  fi
  sleep "$tick" >/dev/null 2>&1 &
  wait $!
done

wait "${loggers[@]}" 2>/dev/null
say "exiting $result after SIG$stopping"
exit "$result"
