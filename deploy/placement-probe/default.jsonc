{
  "main": "../../src/experiments/placement-target.ts",
  "compatibility_date": "2024-12-01",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "SEARCH_CONTROL",
      "bucket_name": "typeahead-index"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTE_AUTHORITY",
        "class_name": "RouteAuthority",
        "script_name": "typeahead-search-transport"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": [
        "logfire-typeahead-traces"
      ]
    }
  },
  "name": "typeahead-probe-default"
}
